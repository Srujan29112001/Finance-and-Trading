# Finance Analytics & Trading Co-Pilot - Environment Configuration

# OpenAI API (optional - for enhanced AI responses)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Hugging Face Token (optional - for downloading models)
HF_TOKEN=your-huggingface-token-here

# Database Credentials (these match docker-compose.yml defaults)
POSTGRES_USER=financeuser
POSTGRES_PASSWORD=financepass
POSTGRES_DB=financedb

# MongoDB
MONGODB_USER=financeuser
MONGODB_PASSWORD=financepass

# Neo4j
NEO4J_USER=neo4j
NEO4J_PASSWORD=financepass

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Security
SECRET_KEY=change-this-to-a-random-secret-key-in-production
JWT_SECRET=change-this-jwt-secret-key

# Feature Flags
ENABLE_METRICS=true
DEBUG=false

# Email Notifications (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
ALERT_EMAIL=alerts@example.com

# External APIs (optional - for real market data)
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-key
FINNHUB_API_KEY=your-finnhub-key

# MLflow Tracking
MLFLOW_TRACKING_URI=http://mlflow:5000

# Logging
LOG_LEVEL=INFO
