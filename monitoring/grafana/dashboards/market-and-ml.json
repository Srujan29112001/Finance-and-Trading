{
  "dashboard": {
    "title": "Finance Analytics - Market Data & ML Performance",
    "tags": ["finance", "market", "ml", "trading"],
    "timezone": "browser",
    "schemaVersion": 27,
    "version": 1,
    "refresh": "30s",
    "panels": [
      {
        "id": 1,
        "title": "Market Data Events (Kafka)",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "rate(kafka_topic_partition_current_offset{topic=\"market_prices\"}[1m])",
            "legendFormat": "Market Prices - Partition {{partition}}",
            "refId": "A"
          },
          {
            "expr": "rate(kafka_topic_partition_current_offset{topic=\"news_events\"}[1m])",
            "legendFormat": "News Events - Partition {{partition}}",
            "refId": "B"
          },
          {
            "expr": "rate(kafka_topic_partition_current_offset{topic=\"social_tweets\"}[1m])",
            "legendFormat": "Social Tweets - Partition {{partition}}",
            "refId": "C"
          }
        ],
        "yaxes": [
          {"format": "msg/s", "label": "Messages/sec"},
          {"format": "short"}
        ]
      },
      {
        "id": 2,
        "title": "Stock Price Ticks Processed",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
        "targets": [
          {
            "expr": "sum(increase(stock_prices_processed_total[1h]))",
            "refId": "A"
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "orientation": "auto",
          "textMode": "value_and_name"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "displayName": "Ticks (1h)"
          }
        }
      },
      {
        "id": 3,
        "title": "Alerts Generated",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
        "targets": [
          {
            "expr": "sum(increase(market_alerts_generated_total[1h]))",
            "refId": "A"
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "orientation": "auto",
          "textMode": "value_and_name"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "displayName": "Alerts (1h)",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 10},
                {"color": "red", "value": 50}
              ]
            }
          }
        }
      },
      {
        "id": 4,
        "title": "Trading Signals Generated",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 12, "y": 4},
        "targets": [
          {
            "expr": "sum(increase(trading_signals_generated_total[1h]))",
            "refId": "A"
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "orientation": "auto",
          "textMode": "value_and_name"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "displayName": "Signals (1h)"
          }
        }
      },
      {
        "id": 5,
        "title": "AI Chat Queries",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 18, "y": 4},
        "targets": [
          {
            "expr": "sum(increase(ai_chat_queries_total[1h]))",
            "refId": "A"
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "orientation": "auto",
          "textMode": "value_and_name"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "displayName": "Queries (1h)"
          }
        }
      },
      {
        "id": 6,
        "title": "LLM Inference Time",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(llm_inference_duration_seconds_bucket[5m]))",
            "legendFormat": "p95 Inference Time",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.50, rate(llm_inference_duration_seconds_bucket[5m]))",
            "legendFormat": "p50 Inference Time",
            "refId": "B"
          }
        ],
        "yaxes": [
          {"format": "s", "label": "Duration"},
          {"format": "short"}
        ]
      },
      {
        "id": 7,
        "title": "RL Agent Inference Time",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(rl_agent_inference_duration_seconds_bucket[5m]))",
            "legendFormat": "p95 Inference Time",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.50, rate(rl_agent_inference_duration_seconds_bucket[5m]))",
            "legendFormat": "p50 Inference Time",
            "refId": "B"
          }
        ],
        "yaxes": [
          {"format": "s", "label": "Duration"},
          {"format": "short"}
        ]
      },
      {
        "id": 8,
        "title": "Signal Action Distribution",
        "type": "piechart",
        "gridPos": {"h": 8, "w": 8, "x": 0, "y": 16},
        "targets": [
          {
            "expr": "sum(increase(trading_signals_by_action_total[1h])) by (action)",
            "legendFormat": "{{action}}",
            "refId": "A"
          }
        ],
        "options": {
          "legend": {"displayMode": "table", "placement": "right"},
          "pieType": "donut"
        }
      },
      {
        "id": 9,
        "title": "Average Signal Confidence",
        "type": "gauge",
        "gridPos": {"h": 8, "w": 8, "x": 8, "y": 16},
        "targets": [
          {
            "expr": "avg(trading_signal_confidence)",
            "refId": "A"
          }
        ],
        "options": {
          "showThresholdLabels": false,
          "showThresholdMarkers": true
        },
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "min": 0,
            "max": 1,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "red", "value": 0},
                {"color": "yellow", "value": 0.5},
                {"color": "green", "value": 0.7}
              ]
            }
          }
        }
      },
      {
        "id": 10,
        "title": "Sentiment Score Distribution",
        "type": "histogram",
        "gridPos": {"h": 8, "w": 8, "x": 16, "y": 16},
        "targets": [
          {
            "expr": "sentiment_scores",
            "format": "time_series",
            "refId": "A"
          }
        ]
      },
      {
        "id": 11,
        "title": "Vector DB Query Performance",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(vector_db_query_duration_seconds_bucket[5m]))",
            "legendFormat": "p95",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.50, rate(vector_db_query_duration_seconds_bucket[5m]))",
            "legendFormat": "p50",
            "refId": "B"
          }
        ],
        "yaxes": [
          {"format": "s", "label": "Query Duration"},
          {"format": "short"}
        ]
      },
      {
        "id": 12,
        "title": "Graph DB (Neo4j) Query Performance",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(graph_db_query_duration_seconds_bucket[5m]))",
            "legendFormat": "p95",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.50, rate(graph_db_query_duration_seconds_bucket[5m]))",
            "legendFormat": "p50",
            "refId": "B"
          }
        ],
        "yaxes": [
          {"format": "s", "label": "Query Duration"},
          {"format": "short"}
        ]
      }
    ]
  },
  "overwrite": true
}
